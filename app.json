{
  "expo": {
    "name": "SweetCrust",
    "slug": "sweetcrust-user",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "usermobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "in.sweetcrust.user",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "in.sweetcrust.user",
      "adaptiveIcon": {
        "backgroundColor": "#FFF8EF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0907",
          "image": "./assets/images/sweetcrust-logo.png",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bf99b6be-4c34-4d9a-bfc2-7c941a92a50e"
      }
    }
  }
}
