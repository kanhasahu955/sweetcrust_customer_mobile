# Gateway (backend_v2) — NOT :8000 legacy, NOT :8081 realtime
EXPO_PUBLIC_API_URL=http://127.0.0.1:8080
# Socket.IO realtime service
EXPO_PUBLIC_SOCKET_URL=http://127.0.0.1:8081
# On a physical phone use your Mac LAN IP for both, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.x.x:8080
# EXPO_PUBLIC_SOCKET_URL=http://192.168.x.x:8081
#
# Production / EAS builds (preview + production profiles in eas.json):
# Phones cannot reach 127.0.0.1 — use a public HTTPS URL.
# Override at build time with eas.json env or:
#   eas env:create --name EXPO_PUBLIC_API_URL --value https://api.skbakery.in --environment production
#   eas env:create --name EXPO_PUBLIC_SOCKET_URL --value https://api.skbakery.in --environment production
# EXPO_PUBLIC_API_URL=https://api.skbakery.in
# EXPO_PUBLIC_SOCKET_URL=https://api.skbakery.in
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
