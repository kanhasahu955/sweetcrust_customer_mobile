# iOS Simulator / same Mac: use 127.0.0.1
# Physical phone on Wi‑Fi: use your Mac LAN IP (e.g. http://192.168.31.93:8080)
# Gateway must listen on 0.0.0.0 (not only localhost) for a real phone.
#
# IMPORTANT: Metro must NOT use port 8081 — that is backend_v2 realtime (Socket.IO).
# Use: npm start  →  expo --port 8082
EXPO_PUBLIC_API_URL=http://127.0.0.1:8080
EXPO_PUBLIC_SOCKET_URL=http://127.0.0.1:8081
